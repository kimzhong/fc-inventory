# fc-inventory v3.0.0 — environment-variable template.
# Copy to `.env` and edit. All variables are optional; the defaults
# are the v1.0.0-compatible localhost bind (127.0.0.1:5000).

# Network bind. Use 0.0.0.0 to expose on the LAN; bind behind a reverse
# proxy in production.
FC_INVENTORY_BIND=127.0.0.1
FC_INVENTORY_PORT=5000

# Logging.
FC_INVENTORY_LOG_FILE=fc_inventory.log
FC_INVENTORY_LOG_LEVEL=INFO
FC_INVENTORY_LOG_MAX_BYTES=5242880      # 5 MB
FC_INVENTORY_LOG_BACKUP_COUNT=3

# CORS — comma-separated list of allowed origins. Empty disables CORS.
# Example: FC_INVENTORY_CORS_ORIGINS=http://localhost:3000,https://ui.example.com
FC_INVENTORY_CORS_ORIGINS=

# Output.
FC_INVENTORY_OUTPUT_DIR=.
FC_INVENTORY_REQUEST_TIMEOUT_SECONDS=60
